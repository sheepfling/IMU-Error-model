{
  "$defs": {
    "AcquisitionConfig": {
      "additionalProperties": false,
      "description": "Uniform physical sampling followed by thermal, digital and timestamp effects.\n\nAxis delays are integer-sample readout delays; they do not shift the physical\nsampling aperture. Delays and taps act in fixed instrument-channel coordinates.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sample_period_s": {
          "default": 0.01,
          "exclusiveMinimum": 0.0,
          "title": "Sample Period S",
          "type": "number"
        },
        "accelerometer_filter": {
          "$ref": "#/$defs/FirFilterConfig",
          "default": {
            "taps": [
              1.0
            ]
          }
        },
        "gyroscope_filter": {
          "$ref": "#/$defs/FirFilterConfig",
          "default": {
            "taps": [
              1.0
            ]
          }
        },
        "accelerometer_delay_samples": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Accelerometer Delay Samples",
          "type": "array"
        },
        "gyroscope_delay_samples": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Gyroscope Delay Samples",
          "type": "array"
        },
        "thermal": {
          "$ref": "#/$defs/ThermalLagConfig",
          "default": {
            "time_constant_s": 0.0,
            "initial_die_temperature_celsius": 25.0
          }
        },
        "clock": {
          "$ref": "#/$defs/ClockConfig",
          "default": {
            "epoch_s": 0.0,
            "offset_s": 0.0,
            "frequency_error_ppm": 0.0,
            "timestamp_jitter_bound_s": 0.0,
            "jitter_seed": 0
          }
        }
      },
      "title": "AcquisitionConfig",
      "type": "object"
    },
    "AxisConfig": {
      "additionalProperties": false,
      "description": "Noise and deterministic error parameters for one 3-axis channel.",
      "properties": {
        "white_noise_density": {
          "default": 0.0,
          "description": "White-noise amplitude spectral density in sensor units per square root second; must be non-negative.",
          "minimum": 0.0,
          "title": "White Noise Density",
          "type": "number"
        },
        "turn_on_bias_std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "One-sigma turn-on bias in sensor units, as a scalar broadcast to all axes or a finite non-negative three-axis vector.",
          "title": "Turn On Bias Std"
        },
        "bias_std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "One-sigma stationary Gauss-Markov bias in sensor units, or random-walk driving density in sensor units per square root second, as a scalar broadcast to all axes or a finite non-negative three-axis vector.",
          "title": "Bias Std"
        },
        "bias_correlation_time": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gauss-Markov bias correlation time in seconds; must be positive when provided.",
          "title": "Bias Correlation Time"
        },
        "flicker_bias_std": {
          "default": 0.0,
          "description": "Target one-sigma flicker-bias level in sensor units; must be non-negative.",
          "minimum": 0.0,
          "title": "Flicker Bias Std",
          "type": "number"
        },
        "flicker_min_correlation_time": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lower bound of the flicker correlation-time band in seconds; must be positive when provided.",
          "title": "Flicker Min Correlation Time"
        },
        "flicker_max_correlation_time": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper bound of the flicker correlation-time band in seconds; must be positive and greater than the lower bound when provided.",
          "title": "Flicker Max Correlation Time"
        },
        "flicker_components": {
          "default": 8,
          "description": "Number of first-order components used to approximate flicker bias; must be at least 2 when flicker bias is enabled.",
          "minimum": 2,
          "title": "Flicker Components",
          "type": "integer"
        },
        "fixed_bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Fixed realized additive bias in sensor units, as a scalar broadcast to all axes or a finite three-axis vector.",
          "title": "Fixed Bias"
        },
        "scale_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Dimensionless multiplicative scale-factor error, as a scalar broadcast to all axes or a finite three-axis vector.",
          "title": "Scale Factor"
        },
        "sensitivity_matrix": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional fixed forward 3x3 sensitivity matrix applied after diagonal scale and nonlinearity; identity is used when omitted.",
          "title": "Sensitivity Matrix"
        },
        "nonlinear_factor": {
          "default": 0.0,
          "description": "Dimensionless quadratic nonlinearity coefficient applied to the squared signal magnitude.",
          "title": "Nonlinear Factor",
          "type": "number"
        },
        "misalignment_std": {
          "default": 0.0,
          "description": "Isotropic one-sigma random rotation-vector misalignment angle in radians; use misalignment_covariance for anisotropic uncertainty.",
          "minimum": 0.0,
          "title": "Misalignment Std",
          "type": "number"
        },
        "misalignment_covariance": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional symmetric positive-semidefinite 3x3 covariance of the reset rotation vector in radians squared; mutually exclusive with non-zero misalignment_std.",
          "title": "Misalignment Covariance"
        },
        "measurement_range": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Symmetric channel measurement limit in sensor units; clipping is disabled when omitted and the value must be positive when provided.",
          "title": "Measurement Range"
        },
        "thermal_bias_coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Bias temperature coefficient in sensor units per degree Celsius, as a scalar or finite three-axis vector.",
          "title": "Thermal Bias Coefficient"
        },
        "thermal_noise_coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Noise scale temperature coefficient per degree Celsius, as a scalar or finite three-axis vector.",
          "title": "Thermal Noise Coefficient"
        },
        "thermal_scale_factor_coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "default": 0.0,
          "description": "Scale-factor temperature coefficient per degree Celsius, as a scalar or finite three-axis vector.",
          "title": "Thermal Scale Factor Coefficient"
        },
        "thermal_sensitivity_matrix_coefficient": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additive 3x3 temperature coefficient per degree Celsius for cross-axis sensitivity drift.",
          "title": "Thermal Sensitivity Matrix Coefficient"
        },
        "reference_temperature_celsius": {
          "default": 25.0,
          "description": "Temperature reference point in degrees Celsius for thermal error coefficients.",
          "title": "Reference Temperature Celsius",
          "type": "number"
        },
        "noise_covariance": {
          "anyOf": [
            {
              "items": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional symmetric positive-semidefinite 3x3 covariance matrix for channel noise; omitted uses independent noise.",
          "title": "Noise Covariance"
        },
        "quantization_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quantization step in sensor units, as a positive scalar broadcast to all axes or a finite positive three-axis vector; omitted disables quantization.",
          "title": "Quantization Step"
        },
        "apply_clipping": {
          "default": true,
          "description": "Whether to clip the channel output to plus or minus measurement_range when a range is configured.",
          "title": "Apply Clipping",
          "type": "boolean"
        },
        "output_scale": {
          "default": 1.0,
          "description": "Positive finite output scale applied to this channel's reported increments.",
          "exclusiveMinimum": 0.0,
          "title": "Output Scale",
          "type": "number"
        }
      },
      "title": "AxisConfig",
      "type": "object"
    },
    "ClockConfig": {
      "additionalProperties": false,
      "description": "Reported clock error, NOT physical sampling jitter or oscillator scheduling.\n\ntag(t, k) = epoch + offset + (t - epoch)*(1 + ppm*1e-6) + jitter(k).\nAdjacent intervals share the same jittered boundary, without sorting/clamping.",
      "properties": {
        "epoch_s": {
          "default": 0.0,
          "title": "Epoch S",
          "type": "number"
        },
        "offset_s": {
          "default": 0.0,
          "title": "Offset S",
          "type": "number"
        },
        "frequency_error_ppm": {
          "default": 0.0,
          "exclusiveMinimum": -1000000.0,
          "title": "Frequency Error Ppm",
          "type": "number"
        },
        "timestamp_jitter_bound_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Timestamp Jitter Bound S",
          "type": "number"
        },
        "jitter_seed": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Jitter Seed",
          "type": "integer"
        }
      },
      "title": "ClockConfig",
      "type": "object"
    },
    "FirFilterConfig": {
      "additionalProperties": false,
      "description": "Causal unity-DC-gain FIR; taps are ordered current to oldest sample.",
      "properties": {
        "taps": {
          "default": [
            1.0
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Taps",
          "type": "array"
        }
      },
      "title": "FirFilterConfig",
      "type": "object"
    },
    "ImuConfig": {
