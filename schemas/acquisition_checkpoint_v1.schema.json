    "ImuModelCheckpoint": {
      "additionalProperties": false,
      "description": "Complete resumable state for `imu_error_model.ImuModel`.",
      "properties": {
        "schema_version": {
          "default": 1,
          "description": "Checkpoint envelope schema version.",
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "model_type": {
          "const": "imu_error_model.ImuModel",
          "default": "imu_error_model.ImuModel",
          "description": "Model implementation identifier required to restore this checkpoint.",
          "title": "Model Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/ImuConfig",
          "description": "Canonical IMU configuration used by the model."
        },
        "rng_bit_generator": {
          "description": "Supported NumPy bit-generator class name used by the model RNG.",
          "enum": [
            "PCG64",
            "PCG64DXSM",
            "Philox",
            "SFC64",
            "MT19937"
          ],
          "title": "Rng Bit Generator",
          "type": "string"
        },
        "rng_state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "JSON-compatible NumPy bit-generator state using only nested JSON values.",
          "title": "Rng State",
          "type": "object"
        },
        "accelerometer_turn_on_bias": {
          "description": "Sampled accelerometer turn-on bias state.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
