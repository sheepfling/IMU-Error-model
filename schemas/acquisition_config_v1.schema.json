{
  "$defs": {
    "ClockConfig": {
      "additionalProperties": false,
      "description": "Reported clock error, NOT physical sampling jitter or oscillator scheduling.\n\ntag(t, k) = epoch + offset + (t - epoch)*(1 + ppm*1e-6) + jitter(k).\nAdjacent intervals share the same jittered boundary, without sorting/clamping.",
      "properties": {
        "epoch_s": {
          "default": 0.0,
          "title": "Epoch S",
          "type": "number"
        },
        "offset_s": {
          "default": 0.0,
          "title": "Offset S",
          "type": "number"
        },
        "frequency_error_ppm": {
          "default": 0.0,
          "exclusiveMinimum": -1000000.0,
          "title": "Frequency Error Ppm",
          "type": "number"
        },
        "timestamp_jitter_bound_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Timestamp Jitter Bound S",
          "type": "number"
        },
        "jitter_seed": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Jitter Seed",
          "type": "integer"
        }
      },
      "title": "ClockConfig",
      "type": "object"
    },
    "FirFilterConfig": {
      "additionalProperties": false,
      "description": "Causal unity-DC-gain FIR; taps are ordered current to oldest sample.",
      "properties": {
        "taps": {
          "default": [
            1.0
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Taps",
          "type": "array"
        }
      },
      "title": "FirFilterConfig",
      "type": "object"
    },
    "ThermalLagConfig": {
      "additionalProperties": false,
      "description": "One die-temperature node driven by zero-order-held ambient temperature.",
      "properties": {
        "time_constant_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Time Constant S",
          "type": "number"
        },
        "initial_die_temperature_celsius": {
          "default": 25.0,
          "title": "Initial Die Temperature Celsius",
          "type": "number"
        }
      },
      "title": "ThermalLagConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Uniform physical sampling followed by thermal, digital and timestamp effects.\n\nAxis delays are integer-sample readout delays; they do not shift the physical\nsampling aperture. Delays and taps act in fixed instrument-channel coordinates.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sample_period_s": {
      "default": 0.01,
      "exclusiveMinimum": 0.0,
      "title": "Sample Period S",
      "type": "number"
    },
    "accelerometer_filter": {
      "$ref": "#/$defs/FirFilterConfig",
      "default": {
        "taps": [
          1.0
        ]
      }
    },
    "gyroscope_filter": {
      "$ref": "#/$defs/FirFilterConfig",
      "default": {
        "taps": [
          1.0
        ]
      }
    },
    "accelerometer_delay_samples": {
      "default": [
        0,
        0,
        0
      ],
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "title": "Accelerometer Delay Samples",
      "type": "array"
    },
    "gyroscope_delay_samples": {
      "default": [
        0,
        0,
        0
      ],
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "title": "Gyroscope Delay Samples",
      "type": "array"
    },
    "thermal": {
      "$ref": "#/$defs/ThermalLagConfig",
      "default": {
        "time_constant_s": 0.0,
        "initial_die_temperature_celsius": 25.0
      }
    },
    "clock": {
      "$ref": "#/$defs/ClockConfig",
      "default": {
        "epoch_s": 0.0,
        "offset_s": 0.0,
        "frequency_error_ppm": 0.0,
        "timestamp_jitter_bound_s": 0.0,
        "jitter_seed": 0
      }
    }
  },
  "title": "AcquisitionConfig",
  "type": "object"
}
