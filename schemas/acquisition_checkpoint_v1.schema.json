            "scale_factor": 0.0,
            "sensitivity_matrix": null,
            "nonlinear_factor": 0.0,
            "misalignment_std": 0.0,
            "misalignment_covariance": null,
            "measurement_range": null,
            "thermal_bias_coefficient": 0.0,
            "thermal_noise_coefficient": 0.0,
            "thermal_scale_factor_coefficient": 0.0,
            "thermal_sensitivity_matrix_coefficient": null,
            "reference_temperature_celsius": 25.0,
            "noise_covariance": null,
            "quantization_step": null,
            "apply_clipping": true,
            "output_scale": 1.0
